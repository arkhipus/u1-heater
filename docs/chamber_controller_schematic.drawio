        <mxCell id="node_6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;strokeWidth=3;fontStyle=1;fontSize=12;align=center;" value="ESP-WROOM-32 (30-PIN)&lt;br&gt;On Terminal Shield&lt;br&gt;&lt;br&gt;• VIN (5.0V Power In)&lt;br&gt;• GND (System Ground)&lt;br&gt;• 3V3 (3.3V Out)&lt;br&gt;• GPIO 21 (I2C SDA)&lt;br&gt;• GPIO 22 (I2C SCL)&lt;br&gt;&lt;br&gt;• GPIO 18 (PWM: Flap Servo)&lt;br&gt;• GPIO 23 (Out: Blower MOSFET)&lt;br&gt;• GPIO 25 (Out: 110V Heater Relay)&lt;br&gt;• GPIO 27 Recirculation PWM Sensor&lt;div&gt;• GPIO 26 Exhaust PWM Sensor&lt;br&gt;&lt;br&gt;[ WiFi: Moonraker REST API ]&lt;/div&gt;" vertex="1">
          <mxGeometry height="440" width="320" x="640" y="280" as="geometry" />
        </mxCell>
