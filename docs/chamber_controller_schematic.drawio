        <mxCell id="node_10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff4;strokeColor=#38a169;strokeWidth=2;fontStyle=1;fontSize=12;align=left;spacingLeft=15;" value="NOCTUA NF-F12 24V PWM&lt;br&gt;(120mm Exhaust Fan)&lt;br&gt;&lt;br&gt;• Pin 1 (Yellow): +24V DC&lt;br&gt;• Pin 2 (Black): GND&lt;br&gt;• Pin 3 (Green): Tach / RPM&lt;br&gt;• Pin 4 (Blue): PWM (from U1 Molex)" vertex="1">
