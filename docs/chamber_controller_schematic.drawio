      <mxCell id="node_2" value="⚠️ 110V AC MAINS HIGH-VOLTAGE ISOLATED ZONE&#xa;(Physically separated from all low-voltage lines)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#e53e3e;strokeWidth=2;fillColor=#fff5f5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=12;fontStyle=1;fontColor=#c53030;" parent="1" vertex="1">
        <mxGeometry x="1060" y="520" width="740" height="580" as="geometry" />
      </mxCell>
      <mxCell id="node_3" value="24V DC POWER IN&#xa;(Main Supply from U1)&#xa;&#xa;• Pin 1: +24V DC&#xa;• Pin 2: Power GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#dd6b20;strokeWidth=2;fontStyle=1;fontSize=12;align=left;spacingLeft=15;" parent="1" vertex="1">
        <mxGeometry x="60" y="100" width="200" height="100" as="geometry" />
      </mxCell>
      <mxCell id="node_4" value="MP1584 BUCK CONVERTER&#xa;24V In ➔ 5.00V DC Out&#xa;&#xa;• IN+  |  IN- (GND)&#xa;• OUT+ (5V)  |  OUT- (GND)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#dd6b20;strokeWidth=2;fontStyle=1;fontSize=12;align=left;spacingLeft=15;" parent="1" vertex="1">
        <mxGeometry x="340" y="100" width="220" height="100" as="geometry" />
      </mxCell>
      <mxCell id="node_5" value="COMMON GROUND BUS (GND)&#xa;[ Star-ground distribution ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;strokeColor=#718096;strokeWidth=2;fontStyle=1;fontSize=11;" parent="1" vertex="1">
        <mxGeometry x="340" y="240" width="220" height="40" as="geometry" />
      </mxCell>
      <mxCell id="node_6" value="ESP-WROOM-32 (30-PIN)&#xa;On Terminal Shield&#xa;&#xa;[ LEFT TERMINALS ]&#xa;• VIN (5.0V Power In)&#xa;• GND (System Ground)&#xa;• 3V3 (3.3V Out)&#xa;• GPIO 21 (I2C SDA)&#xa;• GPIO 22 (I2C SCL)&#xa;• GPIO 34 (ADC: 5-Way Switch)&#xa;&#xa;[ RIGHT TERMINALS ]&#xa;• GPIO 18 (PWM: Flap Servo)&#xa;• GPIO 19 (PWM: Noctua 24V)&#xa;• GPIO 23 (Out: Blower MOSFET)&#xa;• GPIO 25 (Out: G3MB-202P SSR)&#xa;&#xa;[ WiFi: Moonraker REST API ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;strokeWidth=3;fontStyle=1;fontSize=12;align=center;" parent="1" vertex="1">
        <mxGeometry x="680" y="220" width="320" height="440" as="geometry" />
      </mxCell>
      <mxCell id="node_7" value="SSD1306 0.96&quot; OLED&#xa;(I2C: 0x3C • Yellow / Blue)&#xa;&#xa;• Pin 1: GND&#xa;• Pin 2: VCC (3.3V)&#xa;• Pin 3: SCL (GPIO 22)&#xa;• Pin 4: SDA (GPIO 21)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#805ad5;strokeWidth=2;fontStyle=1;fontSize=12;align=left;spacingLeft=15;" parent="1" vertex="1">
        <mxGeometry x="60" y="320" width="240" height="130" as="geometry" />
      </mxCell>
      <mxCell id="node_8" value="RS1010 5-WAY SWITCH&#xa;(1-Pin Resistor Ladder)&#xa;&#xa;• Top: 3.3V | Bottom: GND&#xa;• 4x 10kΩ Resistors&#xa;• Pull-down: 100kΩ to GND&#xa;• Pin 1 (Wiper) ➔ GPIO 34&#xa;&#xa;[ 1:OFF | 2:LOW | 3:MED | 4:HI | 5:PURGE ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6fffa;strokeColor=#319795;strokeWidth=2;fontStyle=1;fontSize=11;align=left;spacingLeft=12;" parent="1" vertex="1">
        <mxGeometry x="60" y="500" width="240" height="180" as="geometry" />
      </mxCell>
      <mxCell id="node_9" value="MG90S METAL SERVO&#xa;(Exhaust Butterfly Flap)&#xa;&#xa;• Red: +5.0V (from Buck)&#xa;• Brown: GND (Common)&#xa;• Yellow: Signal (GPIO 18)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#d69e2e;strokeWidth=2;fontStyle=1;fontSize=12;align=left;spacingLeft=15;" parent="1" vertex="1">
        <mxGeometry x="1160" y="60" width="260" height="100" as="geometry" />
      </mxCell>
      <mxCell id="node_10" value="NOCTUA NF-F12 24V PWM&#xa;(120mm Exhaust Fan)&#xa;&#xa;• Pin 1 (Yellow): +24V DC&#xa;• Pin 2 (Black): GND&#xa;• Pin 3 (Green): Tach / RPM&#xa;• Pin 4 (Blue): PWM (GPIO 19)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff4;strokeColor=#38a169;strokeWidth=2;fontStyle=1;fontSize=12;align=left;spacingLeft=15;" parent="1" vertex="1">
        <mxGeometry x="1160" y="200" width="260" height="110" as="geometry" />
      </mxCell>
      <mxCell id="node_11" value="NOYITO AOD4184 MOSFET&#xa;(Optocoupler Isolated)&#xa;&#xa;• DC+: +24V  |  DC-: GND&#xa;• IN+: GPIO 23  |  IN-: GND&#xa;• OUT+: +24V Pass-thru&#xa;• OUT-: Switched Motor (-)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;strokeWidth=2;fontStyle=1;fontSize=12;align=left;spacingLeft=15;" parent="1" vertex="1">
        <mxGeometry x="1160" y="350" width="260" height="120" as="geometry" />
      </mxCell>
      <mxCell id="node_12" value="24V BLOWER FAN&#xa;(Carbon Recirculation)&#xa;&#xa;• Red Wire (+): ➔ OUT+&#xa;• Black Wire (-): ➔ OUT-&#xa;&#xa;*Feeds 24V to AEDIKO Interlock*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff4;strokeColor=#38a169;strokeWidth=2;fontStyle=1;fontSize=12;align=left;spacingLeft=15;" parent="1" vertex="1">
        <mxGeometry x="1500" y="350" width="240" height="120" as="geometry" />
      </mxCell>
      <mxCell id="node_13" value="G3MB-202P 5V SSR MODULE&#xa;(Silent AC Solid State Relay • 2A 240V)&#xa;&#xa;[ DC CONTROL ] VCC: 5V | GND | IN: GPIO 25&#xa;[ 110V AC LOAD ] Terminal 1 | Terminal 2&#xa;(Switches 110V Live for Temp Regulation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#dd6b20;strokeWidth=2;fontStyle=1;fontSize=11;align=left;spacingLeft=12;" parent="1" vertex="1">
        <mxGeometry x="1160" y="580" width="260" height="110" as="geometry" />
      </mxCell>
      <mxCell id="node_14" value="AEDIKO 24V RELAY (INTERLOCK)&#xa;[DC+ &amp; IN Shorted ➔ Blower (+)]&#xa;[DC- ➔ Blower (-)]&#xa;&#xa;COM: In from SSR | NO: Out to KSD301&#xa;(Relay closes ONLY when blower runs!)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#e53e3e;strokeWidth=2;fontStyle=1;fontSize=11;align=left;spacingLeft=12;" parent="1" vertex="1">
        <mxGeometry x="1160" y="720" width="260" height="120" as="geometry" />
      </mxCell>
      <mxCell id="node_15" value="110V AC MAINS INFEED&#xa;(Wall Cord)&#xa;&#xa;• Live (L): Black Wire&#xa;• Neutral (N): White Wire&#xa;• Earth (PE): Green Wire" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#e53e3e;strokeWidth=2;fontStyle=1;fontSize=12;align=left;spacingLeft=15;" parent="1" vertex="1">
        <mxGeometry x="860" y="800" width="200" height="120" as="geometry" />
