          <mxGeometry height="580" width="720" x="970" y="850" as="geometry" />
        </mxCell>
        <mxCell id="node_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#dd6b20;strokeWidth=2;fontStyle=1;fontSize=11;align=left;spacingLeft=12;" value="SNAPMAKER U1 TOP PORT&lt;br&gt;(Molex Micro-Fit 3.0 2×3)&lt;br&gt;&lt;br&gt;• Pin 6: Fused +24V DC Out&lt;br&gt;• Pin 2: Ground (GND)&lt;br&gt;• Pin 4: FLAG2 (10k to GND)&lt;br&gt;• Pin 5: PWM (PA8 Exhaust)&lt;br&gt;• Pin 1: PA9 (Inner Fan PWM)" vertex="1">
          <mxGeometry height="130" width="220" x="60" y="135" as="geometry" />
        </mxCell>
        <mxCell id="node_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#dd6b20;strokeWidth=2;fontStyle=1;fontSize=12;align=left;spacingLeft=15;" value="MP1584 BUCK CONVERTER&#xa;24V In ➔ 5.00V DC Out&#xa;&#xa;• IN+  |  IN- (GND)&#xa;• OUT+ (5V)  |  OUT- (GND)" vertex="1">
          <mxGeometry height="100" width="220" x="340" y="100" as="geometry" />
        </mxCell>
        <mxCell id="node_5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;strokeColor=#718096;strokeWidth=2;fontStyle=1;fontSize=11;" value="COMMON GROUND BUS (GND)&#xa;[ Star-ground distribution ]" vertex="1">
          <mxGeometry height="40" width="220" x="340" y="240" as="geometry" />
        </mxCell>
        <mxCell id="WMdCMO2jiq75RD34SFOT-3" edge="1" parent="1" source="node_6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;strokeWidth=3;strokeColor=#007FFF;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="node_6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;strokeWidth=3;fontStyle=1;fontSize=12;align=center;" value="ESP-WROOM-32 (30-PIN)&lt;br&gt;On Terminal Shield&lt;br&gt;&lt;br&gt;[ LEFT TERMINALS ]&lt;br&gt;• VIN (5.0V Power In)&lt;br&gt;• GND (System Ground)&lt;br&gt;• 3V3 (3.3V Out)&lt;br&gt;• GPIO 21 (I2C SDA)&lt;br&gt;• GPIO 22 (I2C SCL)&lt;br&gt;• GPIO 34 (ADC: 5-Way Switch)&lt;br&gt;&lt;br&gt;[ RIGHT TERMINALS ]&lt;br&gt;• GPIO 18 (PWM: Flap Servo)&lt;br&gt;• GPIO 19 (PWM: Noctua 24V)&lt;br&gt;• GPIO 23 (Out: Blower MOSFET)&lt;br&gt;• GPIO 25 (Out: 110V Heater Relay)&lt;br&gt;&lt;br&gt;[ WiFi: Moonraker REST API ]" vertex="1">
          <mxGeometry height="440" width="320" x="640" y="280" as="geometry" />
        </mxCell>
        <mxCell id="node_7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#805ad5;strokeWidth=2;fontStyle=1;fontSize=12;align=left;spacingLeft=15;" value="SSD1306 0.96&quot; OLED&#xa;(I2C: 0x3C • Yellow / Blue)&#xa;&#xa;• Pin 1: GND&#xa;• Pin 2: VCC (3.3V)&#xa;• Pin 3: SCL (GPIO 22)&#xa;• Pin 4: SDA (GPIO 21)" vertex="1">
          <mxGeometry height="130" width="240" x="60" y="320" as="geometry" />
        </mxCell>
        <mxCell id="node_8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6fffa;strokeColor=#319795;strokeWidth=2;fontStyle=1;fontSize=11;align=left;spacingLeft=12;" value="RS1010 5-WAY SWITCH&#xa;(1-Pin Resistor Ladder)&#xa;&#xa;• Top Supply: 3.3V&#xa;• Resistors: 4x 10kΩ in series&#xa;• Pull-down: 100kΩ to GND&#xa;• Pin 1 (Wiper) ➔ GPIO 34&#xa;&#xa;[ 1:OFF | 2:LOW | 3:MED | 4:HI | 5:PURGE ]" vertex="1">
          <mxGeometry height="180" width="240" x="60" y="510" as="geometry" />
        </mxCell>
        <mxCell id="node_9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#d69e2e;strokeWidth=2;fontStyle=1;fontSize=12;align=left;spacingLeft=15;" value="MG90S METAL SERVO&#xa;(Exhaust Butterfly Flap)&#xa;&#xa;• Red: +5.0V (from Buck)&#xa;• Brown: GND (Common)&#xa;• Yellow: Signal (GPIO 18)" vertex="1">
          <mxGeometry height="100" width="260" x="1550" y="60" as="geometry" />
        </mxCell>
        <mxCell id="node_10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff4;strokeColor=#38a169;strokeWidth=2;fontStyle=1;fontSize=12;align=left;spacingLeft=15;" value="NOCTUA NF-F12 24V PWM&#xa;(120mm Exhaust Fan)&#xa;&#xa;• Pin 1 (Yellow): +24V DC&#xa;• Pin 2 (Black): GND&#xa;• Pin 3 (Green): Tach / RPM&#xa;• Pin 4 (Blue): PWM (GPIO 19)" vertex="1">
          <mxGeometry height="110" width="260" x="1160" y="200" as="geometry" />
        </mxCell>
